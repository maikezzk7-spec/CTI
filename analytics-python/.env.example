# ============================================
# CTI INSIGHTS - CONFIGURACOES DO PYTHON
# ============================================

# ---- Banco Azure PostgreSQL ----
# Substitua pelos dados do seu proprio banco.

DB_HOST=SEU-SERVIDOR.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=SEU_USUARIO_AZURE
DB_PASSWORD=SUA_SENHA_AZURE
DB_SSLMODE=require

# ---- Integracao com Spring Boot ----
# A mesma chave deve ser utilizada em:
# backend/.env -> ETL_KEY
# analytics-python/.env -> ETL_API_KEY

ETL_API_KEY=DEFINA_UMA_CHAVE_COMPARTILHADA
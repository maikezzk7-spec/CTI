# Copie para ".env" nesta pasta (backend/.env). O Spring Boot lê este arquivo sozinho.
# ---- Banco PostgreSQL (Neon ou Azure) ----
# NEON: no link do Neon  postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require&channel_binding=require
#   DB_URL      = jdbc:postgresql://HOST/BANCO?sslmode=require      (sem usuário, sem senha e SEM channel_binding)
#   DB_USER     = USUARIO        DB_PASSWORD = SENHA
# Exemplo: DB_URL=jdbc:postgresql://ep-nome-123456.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Troque SEU-SERVIDOR, o usuário e a senha pelos do seu servidor PostgreSQL no Azure.

# ============================================
# CTI INSIGHTS - CONFIGURACOES DO BACKEND
# ============================================

# ---- Servidor ----
SERVER_PORT=8080

# ---- Banco Azure PostgreSQL ----
# Substitua pelos dados do seu proprio banco.
DB_URL=jdbc:postgresql://SEU-SERVIDOR.postgres.database.azure.com:5432/postgres?sslmode=require
DB_USER=SEU_USUARIO_AZURE
DB_PASSWORD=SUA_SENHA_AZURE

# ---- JWT ----
# Gere uma chave aleatoria e segura para assinar os tokens.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE
JWT_EXPIRATION_MINUTES=480

# ---- CORS ----
# Endereco utilizado pelo frontend Vue/Vite.
CORS_ORIGINS=http://localhost:5173

# ---- Administrador inicial ----
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@cti.local
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE

# ---- Upload ----
UPLOAD_MAX_LINHAS=5000

# ---- Python (ETL) ----
# Endereco da API FastAPI.
ETL_URL=http://localhost:8000/etl

# Chave compartilhada com o servico Python.
# Deve corresponder ao ETL_API_KEY do Python.
ETL_KEY=DEFINA_UMA_CHAVE_COMPARTILHADA